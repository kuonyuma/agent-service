# 复制为 .env 仅供 Docker Compose 本地开发使用；不要提交真实密钥。
GEMINI_API_KEY=
MYSQL_DATABASE=agent_service
MYSQL_USER=agent_service
MYSQL_PASSWORD=agent_service_dev
MYSQL_ROOT_PASSWORD=agent_service_root_dev

# 默认保持只读；只应在本机工作区隔离下按需开启。
AGENT_SERVICE_WEB_MUTATING_TOOLS_ENABLED=false
AGENT_SERVICE_WEB_QUALITY_TOOL_ENABLED=false
AGENT_SERVICE_APPROVAL_TIMEOUT_SECONDS=60
